# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# MongoDB Atlas Connection String (Required in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/roomkhoj?retryWrites=true&w=majority

# JWT Security (Use a strong 64+ char random string in production)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Image Storage Configuration
# Use "cloudinary" in production. Use "local" only for local development without Cloudinary credentials.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mobile OTP Verification (Optional - leave OTP_PROVIDER empty if not configured)
# Supported: twilio
OTP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Bootstrap (used ONLY by `npm run seed` to create initial admin account)
ADMIN_NAME=RoomKhoj Admin
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=ChangeMe@Admin123
